extends layout

block content
  +encabezado("Mi perfil", "Actualizá tus datos de contacto. El DNI no se puede modificar.")

  +seccion("Datos personales")
    +alerta("errorPerfil")
    p#mensajeExito(hidden role="status" class="mb-4 rounded-lg border border-turno-presente/30 bg-turno-presente/10 px-4 py-3 text-sm font-medium text-green-900")
    form#formPerfil(class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2")
      +campo("nombre", "Nombre")(type="text" name="nombre" autocomplete="given-name" required)
      +campo("apellido", "Apellido")(type="text" name="apellido" autocomplete="family-name" required)
      +campo("dni", "DNI", { sinMarca: true })(type="text" name="dni" readonly aria-describedby="ayudaDni" class="cursor-not-allowed bg-gray-100")
      p#ayudaDni(class="text-xs text-gray-500 sm:col-span-2") El DNI no se puede modificar.
      +campo("telefono", "Teléfono")(type="tel" name="telefono" autocomplete="tel")
      +campo("email", "Email")(type="email" name="email" autocomplete="email")
      +botonera
        button.btn.btn-primario(type="submit")
          +icono("guardar")(class="size-4")
          | Guardar cambios

block scripts
  script(src="/js/miPerfil.js")
