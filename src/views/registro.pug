extends layouts/base

block titulo
  | Registro para Clientes · TurnoFlex

block cuerpo
  main(class="flex flex-1 items-center justify-center px-4 py-10 sm:py-16")
    div(class="w-full max-w-2xl rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8")
      div(class="mb-6 flex flex-col items-center text-center")
        +logo("grande")
        h1(class="mt-4 text-2xl font-bold tracking-tight text-indigo-profundo") Registro para Clientes
        p(class="mt-1 text-sm text-gray-600") Creá tu cuenta para reservar clases grupales y consultar tu historial.
      +alerta("errorRegistro")
      form#formRegistro(class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2")
        +campo("nombre", "Nombre")(type="text" name="nombre" autocomplete="given-name" required)
        +campo("apellido", "Apellido")(type="text" name="apellido" autocomplete="family-name" required)
        +campo("dni", "DNI")(type="text" name="dni" inputmode="numeric" pattern="[0-9]{7,8}" minlength="7" maxlength="8" required)
        +campo("telefono", "Teléfono")(type="tel" name="telefono" autocomplete="tel")
        +campo("email", "Email")(type="email" name="email" autocomplete="email")
        +campo("usuario", "Usuario")(type="text" name="usuario" autocomplete="username" minlength="3" maxlength="30" pattern="[a-zA-Z0-9._-]{3,30}" required)
        +campo("password", "Contraseña")(type="password" name="password" autocomplete="new-password" minlength="6" required)
        +campo("passwordConfirmar", "Repetí la contraseña")(type="password" name="passwordConfirmar" autocomplete="new-password" minlength="6" required)
        div(class="col-span-full flex flex-col gap-3 pt-2")
          button.btn.btn-primario(type="submit" class="w-full py-2.5") Crear cuenta
          a(href="/login" class="text-center text-sm font-medium text-marca underline-offset-4 hover:underline") Ya tengo una cuenta

block scripts
  script(src="/js/registro.js")
