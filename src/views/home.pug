extends layout

block content
  +encabezado("Hola, " + usuario.nombre)
    p(class="flex flex-wrap items-center gap-2 text-sm text-gray-600")
      span Rol:
      span.etiqueta.etiqueta-info= usuario.rol
      if usuario.rol === "profesional"
        span Ves únicamente tus propias clases.

  section(aria-labelledby="tituloResumen")
    h2#tituloResumen(class="mb-3 text-lg font-semibold text-gray-900") Reservas de hoy
    div(class="grid grid-cols-1 gap-4 sm:grid-cols-3")
      +tarjetaResumen("cantidadReservados", "Reservas activas", "reloj", "confirmado")
      +tarjetaResumen("cantidadAtendidos", "Asistencias", "atendido", "finalizado")
      +tarjetaResumen("cantidadCancelados", "Cancelaciones", "cancelado", "cancelado")

  +seccion("Clases del día")
    +alerta("errorReservas")
    +tabla(["Fecha", "Hora", "Clase", "Cliente", "Instructor", "Sala", "Estado", "Acciones"], "tablaReservas")
    +vacio("sinReservas", "No hay reservas para hoy.")

block scripts
  script(src="/js/reservasTabla.js")
  script(src="/js/panel.js")
