extends ../layout

block content
  +encabezado(soloLectura ? "Clases de la semana" : "Clases disponibles", soloLectura ? "Consultá las clases programadas de la semana." : "Elegí un día para consultar las clases programadas y reservar tu lugar.")

  +seccion("Calendario semanal")
    +alerta("errorClases")
    div(class="mb-4 flex flex-wrap items-center justify-between gap-3")
      button#semanaAnterior(type="button" class="btn btn-secundario" aria-label="Ver semana anterior")
        | ← Semana anterior
      p#tituloSemana(class="text-sm font-semibold capitalize text-gray-800" aria-live="polite")
      button#semanaSiguiente(type="button" class="btn btn-secundario" aria-label="Ver semana siguiente")
        | Semana siguiente →
    div(class="overflow-x-auto pb-2")
      div#selectorDias(class="grid min-w-[35rem] grid-cols-7 gap-2" role="group" aria-label="Elegir día")
    div(class="my-5 max-w-md")
      label(for="buscarClase" class="mb-1.5 block text-sm font-medium text-gray-800") Buscar clase por nombre
      input#buscarClase(type="search" class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs placeholder:text-gray-400 focus:border-marca focus:outline-none focus:ring-2 focus:ring-marca/30" placeholder="Ej.: Pilates Reformer" autocomplete="off")
    h3#fechaSeleccionada(class="mb-3 text-base font-semibold capitalize text-gray-900" aria-live="polite")
    div#listaClases(class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3")
    +vacio("sinClases", "No hay clases programadas para este día.")
    +vacio("sinResultados", "No hay clases que coincidan con la búsqueda.")

  +modal("modalDetalleClase", "Detalle de la clase")
    if !soloLectura
      +alerta("errorReservaClase")
    div#detalleClase(class="space-y-3 text-sm text-gray-700")
    div(class="mt-6 flex flex-wrap justify-end gap-3")
      button.btn.btn-secundario.btn-cerrar-modal(type="button") Cerrar
      if !soloLectura
        button#reservarClase.btn.btn-primario(type="button") Reservar lugar

  if !soloLectura
    +seccion("Mis reservas")
      +alerta("errorReservas")
      if usuario.rol === "cliente"
        +tabla(["Fecha", "Hora", "Clase", "Instructor", "Sala", "Estado", "Acciones"], "tablaReservas")
      else
        +tabla(["Fecha", "Hora", "Clase", "Cliente", "Instructor", "Sala", "Estado", "Acciones"], "tablaReservas")
      +vacio("sinReservas", "Todavía no reservaste clases.")

block scripts
  if !soloLectura
    script(src="/js/reservasTabla.js")
  script(src="/js/clasesDisponibles.js")
